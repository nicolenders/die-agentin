# ---------------------------------------------------------------------------
# nicolenders.com — Umgebungsvariablen (SPEC §16)
# Kopiere diese Datei nach `.env` und fülle die Platzhalter.
# NIEMALS echte Secrets committen. `.env*` ist in .gitignore.
# ---------------------------------------------------------------------------

# Datenbank -----------------------------------------------------------------
# Lokal (docker compose): SQL Server im Container.
# Produktiv: Azure SQL, Referenz aus Key Vault (siehe docs/decisions/0002-db-auth.md).
DATABASE_URL="sqlserver://localhost:1433;database=nicolenders;user=sa;password=CHANGE_ME_Local_Dev_Only;encrypt=true;trustServerCertificate=true"

# Auth.js v5 / Microsoft Entra ID -------------------------------------------
AUTH_SECRET="generate-with: npx auth secret"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Kommaseparierte Entra Object IDs, die Admin/Editor-Zugriff erhalten.
ADMIN_OBJECT_IDS=""

# Öffentliche URL -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Kanonischer Host (nur Hostname, ohne Schema). Einzige Quelle für canonical/OG
# und für die noindex-Entscheidung: Jeder andere Host bekommt X-Robots-Tag
# noindex,nofollow (Phase 1.2). Beim Cutover (Phase 14) nur diesen Wert umstellen.
# Leer lassen = kein Host-Gate (Entwicklung). Produktiv: "nicolenders.com".
PUBLIC_SITE_HOST=""

# Blob Storage (Medien) -----------------------------------------------------
BLOB_ACCOUNT_NAME=""
BLOB_CONTAINER_MEDIA="media"
BLOB_CONTAINER_UPLOADS="uploads"

# Scheduler-Job -------------------------------------------------------------
# Schützt POST /api/jobs/run. Muss dem Wert im Container Apps Job entsprechen.
JOB_SHARED_SECRET="generate-a-long-random-string"

# LinkedIn ------------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Microsoft Foundry (EN-Übersetzungsvorschlag) ------------------------------
FOUNDRY_ENDPOINT=""
FOUNDRY_DEPLOYMENT=""
FOUNDRY_API_KEY=""

# Mailversand (Erinnerung an Depeschen) -------------------------------------
# Ohne SMTP_HOST und SMTP_FROM wird nichts verschickt; die Einstellungen sagen
# das ausdrücklich. Siehe docs/decisions/0023-erinnerungsmail-per-smtp.md.
SMTP_HOST=""
# 587 = STARTTLS (Standard), 465 = direkt verschlüsselt.
SMTP_PORT="587"
# Leer lassen: wird aus dem Port abgeleitet. "true" erzwingt implizites TLS.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Absender, z. B. "Die Agentin <zentrale@nicolenders.com>".
SMTP_FROM=""
