        "amount": "[parameters('monthlyBudget')]",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]"
        },
        "notifications": {
          "Actual80": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 80,
            "contactEmails": [
              "[parameters('budgetContactEmail')]"
            ],
            "thresholdType": "Actual"
          },
          "Forecast100": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "contactEmails": [
              "[parameters('budgetContactEmail')]"
            ],
            "thresholdType": "Forecasted"
          }
        }
      }
