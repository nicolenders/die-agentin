// Prisma-Schema (SPEC §3.1, vollständig ausgebaut).
//
// Wichtige Anpassung ggü. SPEC §3.1: Der `sqlserver`-Connector von Prisma
// unterstützt KEINE nativen Enums. Alle Enum-Felder sind deshalb als `String`
// modelliert; die zulässigen Werte und ihre Typen liegen in `lib/domain.ts`
// und werden in Server Actions / beim Seed validiert. Siehe
// docs/decisions/0004-sqlserver-enums.md.
//
// Zeit: alle DateTime-Werte werden in UTC gespeichert (SPEC §6, CLAUDE.md).

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Beiträge (Signale, Kurzmeldungen, Backstage)
// ---------------------------------------------------------------------------

model Post {
  id          String    @id @default(cuid())
  type        String // PostType: SIGNAL | NOTE | BACKSTAGE
  status      String    @default("DRAFT") // ContentStatus
  publishAt   DateTime? // geplanter Zeitpunkt, UTC
  publishedAt DateTime?

  // nur bei type = SIGNAL:
  sourceUrl   String? @db.NVarChar(2048)
  sourceTitle String?
  sourceSite  String?
  sourceImage String? @db.NVarChar(2048)

  heroAssetId String?
  heroAsset   MediaAsset? @relation("PostHero", fields: [heroAssetId], references: [id])

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PostTranslation[]
  tasks        ChannelTask[]

  @@index([status, publishAt])
  @@index([type])
}

model PostTranslation {
  id         String  @id @default(cuid())
  postId     String
  locale     String // Locale: de | en
  slug       String
  title      String
  summary    String? @db.NVarChar(600) // Karten, Feed, OpenGraph
  bodyJson   String  @db.NVarChar(Max) // TipTap-Dokument (JSON)
  socialText String? @db.NVarChar(2000)
  state      String  @default("MISSING") // TransState

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
}

// ---------------------------------------------------------------------------
// Dossiers (langlebige Wissensseiten)
// ---------------------------------------------------------------------------

model Dossier {
  id         String    @id @default(cuid())
  status     String    @default("DRAFT") // ContentStatus
  publishAt  DateTime?
  categoryId String?
  category   Taxonomy? @relation("DossierCategory", fields: [categoryId], references: [id])
  reviewedAt DateTime? // „zuletzt geprüft am" – öffentlich sichtbar
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  translations DossierTranslation[]
  posts        Post[]
  // Mehrfachauswahl (SPEC-Erweiterung): mehrere Kategorien je Dossier.
  // `categoryId` bleibt als „primäre" Kategorie erhalten (Abwärtskompatibilität).
  categories   Taxonomy[]           @relation("DossierCategories")

  @@index([status, publishAt])
}

model DossierTranslation {
  id         String  @id @default(cuid())
  dossierId  String
  locale     String
  slug       String
  title      String
  summary    String? @db.NVarChar(600)
  bodyJson   String  @db.NVarChar(Max)
  tocEnabled Boolean @default(true)
  state      String  @default("MISSING")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, locale])
  @@unique([locale, slug])
}

// ---------------------------------------------------------------------------
// Einsätze / Missionen (Reiseblog + Karte)
// ---------------------------------------------------------------------------

model Mission {
  id              String      @id @default(cuid())
  eventName       String
  city            String
  countryCode     String      @db.Char(2)
  lat             Float
  lon             Float
  // Online-/Remote-Veranstaltung ohne festen Ort. Wird auf der Karte in der
  // Antarktis geplottet (dort findet nichts statt — der Ort ist erkennbar
  // symbolisch) und kann in der Einsatzliste aus-/eingeblendet werden.
  isOnline        Boolean     @default(false)
  // Steuert, ob die öffentliche Einsatzakte (Detailseite) verlinkt wird. Ohne
  // diese Freigabe erscheint weder im Karten-Popup noch in der Liste ein Link —
  // so führt kein Button auf eine Seite, die noch keinen Inhalt hat. Default aus.
  caseFilePublic  Boolean     @default(false)
  startDate       DateTime
  endDate         DateTime?
  status          String      @default("PLANNED") // MissionStatus
  eventUrl        String?     @db.NVarChar(2048)
  contentStatus   String      @default("DRAFT") // ContentStatus
  // Belegmaterial (Phase 9.1) — alle optional, Altdaten dürfen nicht brechen.
  // Hochgeladene Foliendatei (PDF). Pfad in der Medienablage + Originalname für
  // den Download-Link. Getrennt von MediaAsset, damit die Bild-Mediathek sauber
  // bleibt. Öffentlich als Download angeboten (Phase: Einsätze-Umbau).
  slidesFilePath  String?     @db.NVarChar(2048)
  slidesFileName  String?
  recordingUrl    String?     @db.NVarChar(2048) // YouTube o. Ä., datenschutzfreundlich eingebettet
  recapDe         String?     @db.NVarChar(Max) // TipTap JSON
  recapEn         String?     @db.NVarChar(Max)
  coSpeakers      String?     @db.NVarChar(Max) // JSON [{ name, url }]
  sessionType     String? // SessionType: KEYNOTE | SESSION | WORKSHOP | PANEL
  // Sprache, in der der Vortrag gehalten wurde — als Locale-Kürzel („de"/„en"),
  // gesetzt aus der EINEN Sprachauswahl der Erfassungsmaske. Frühere Freitexte
  // („Deutsch") werden beim Lesen normalisiert.
  sessionLanguage String?
  // Tatsächliche Länge dieses Auftritts in Minuten. Vorbelegt aus dem Briefing
  // (Talk.durationMin), aber je Einsatz überschreibbar — dieselbe Session dauert
  // auf einer Konferenz 45 und im Webinar 30 Minuten.
  durationMin     Int?
  // Publikum in drei Zahlen statt einer: wer im Raum saß, wer zugeschaltet war
  // und wie oft die Aufzeichnung später abgerufen wurde. Alle optional.
  attendeesOnsite Int?
  attendeesRemote Int?
  onDemandViews   Int?
  bannerAssetId   String?
  banner          MediaAsset? @relation("MissionBanner", fields: [bannerAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  translations MissionTranslation[]
  photos       MissionPhoto[]
  deliveries   TalkDelivery[]
  posts        Post[]
  identities   Identity[]           @relation("IdentityMissions")
  tools        Tool[]               @relation("MissionTools")
  reportTask   MissionReportTask?

  @@index([startDate])
  @@index([contentStatus])
}

// Aufgabe „Einsatzbericht schreiben" zu genau einem Einsatz. Sie steht im
// Terminkalender neben dem Einsatz selbst und erinnert daran, dass nach dem
// Auftritt noch Text fehlt. Abhaken lässt sie sich erst, wenn die Pflichttexte
// des Einsatzes (Veranstaltung und Vortrag, deutsche Fassung) gefüllt sind —
// die Regel steht in lib/missions/report-task.ts und gilt serverseitig.
model MissionReportTask {
  id                   String    @id @default(cuid())
  missionId            String    @unique
  // Stichtag ist der Einsatztag selbst (Mission.startDate). Der Bericht hängt
  // am Auftritt, nicht an einer eigenen Frist.
  dueOn                DateTime
  status               String    @default("OPEN") // TaskStatus: OPEN | DONE
  doneAt               DateTime?
  // Zwei Erinnerungen je Aufgabe: einmal vor dem Einsatz („denk an Fotos"),
  // einmal danach („der Bericht fehlt noch"). Die Marken verhindern, dass
  // dieselbe Erinnerung mehrfach herausgeht; ein verschobener Einsatztag setzt
  // sie zurück.
  reminderBeforeSentAt DateTime?
  reminderAfterSentAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([status, dueOn])
}

model MissionTranslation {
  id        String @id @default(cuid())
  missionId String
  locale    String
  slug      String
  eventText String @db.NVarChar(Max) // Bereich 1: die Veranstaltung
  talkText  String @db.NVarChar(Max) // Bereich 2: mein Vortrag
  state     String @default("MISSING")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, locale])
  @@unique([locale, slug])
}

model MissionPhoto {
  id        String @id @default(cuid())
  missionId String
  assetId   String
  sortOrder Int    @default(0)

  mission Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id])

  @@index([missionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Briefings / Vorträge
// ---------------------------------------------------------------------------

model Talk {
  id          String    @id @default(cuid())
  categoryId  String
  category    Taxonomy  @relation("TalkCategory", fields: [categoryId], references: [id])
  level       String? // "100" | "200" | "300" | "400"
  durationMin Int?
  active      Boolean   @default(true) // öffentlich sichtbar (auf der Website angezeigt)
  // Archiviert ab diesem Tag: das Briefing wird öffentlich nicht mehr gezeigt
  // und ist bei NEUEN Einsätzen ab diesem Datum nicht mehr wählbar. Ältere
  // Einsätze behalten ihre Zuordnung und können sie auch nachträglich noch
  // bekommen — gehalten wurde der Vortrag ja damals (SPEC: Historie bleibt wahr).
  archivedAt  DateTime?
  sortOrder   Int       @default(0) // manuelle Reihenfolge auf der öffentlichen Seite
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations TalkTranslation[]
  deliveries   TalkDelivery[]
  slideDecks   TalkSlideDeck[]
  attachments  TalkAttachment[]
  categories   Taxonomy[]        @relation("TalkCategories")
  audiences    Taxonomy[]        @relation("TalkAudiences")
  identities   Identity[]        @relation("IdentityTalks")
  tools        Tool[]            @relation("TalkTools")

  @@index([categoryId])
  @@index([sortOrder])
}

// Foliensatz eines Briefings, je Sprache eine Datei (PowerPoint). Bewusst
// getrennt von den Vorlagen in den Einstellungen: Die Vorlage ist der leere
// Rahmen im Corporate Design, hier liegen die fertigen Folien dieses Vortrags.
// Beim Einsatz wird der Foliensatz in der dort gewählten Vortragssprache zum
// Download angeboten — die Zuordnung läuft also über das Briefing, nicht über
// den einzelnen Einsatz.
model TalkSlideDeck {
  id        String   @id @default(cuid())
  talkId    String
  locale    String // „de" | „en"
  blobPath  String   @db.NVarChar(2048) // Pfad in der Medienablage
  fileName  String // Originalname für den Download
  bytes     Int      @default(0) // Größe, sichtbar zur Vollständigkeitsprüfung
  updatedAt DateTime @updatedAt

  talk Talk @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@unique([talkId, locale])
}

// Material am Briefing: Anleitungen, Notizen, Demo-Dateien, Videos — alles,
// was zur Vorbereitung eines Vortrags gehört und beliebig viel sein darf.
//
// Bewusst getrennt von `TalkSlideDeck`: Der Foliensatz ist das eine, definierte
// Ding je Sprache, das ein Einsatz zum Download anbietet. Material ist interne
// Arbeitsablage und erscheint nirgends öffentlich; heruntergeladen wird es über
// eine Route mit Rollenprüfung, nicht über den öffentlichen Medien-Proxy.
model TalkAttachment {
  id        String   @id @default(cuid())
  talkId    String
  kind      String   @default("OTHER") // AttachmentKind: GUIDE|NOTES|DEMO|VIDEO|OTHER
  title     String
  note      String?  @db.NVarChar(Max)
  blobPath  String   @db.NVarChar(2048)
  fileName  String
  mime      String
  // Größe in Bytes. `Int` reicht: die Obergrenze liegt bei 500 MB
  // (lib/briefings/attachments.ts), also weit unter dem Wertebereich.
  bytes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talk Talk @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@index([talkId, sortOrder])
}

model TalkTranslation {
  id       String  @id @default(cuid())
  talkId   String
  locale   String
  title    String
  abstract String? @db.NVarChar(Max)

  talk Talk @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@unique([talkId, locale])
}

model TalkDelivery {
  id        String   @id @default(cuid())
  talkId    String
  missionId String
  language  String // Locale, in der gehalten wurde
  heldOn    DateTime

  talk    Talk    @relation(fields: [talkId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([heldOn])
  @@index([talkId, language])
}

// ---------------------------------------------------------------------------
// Publikationen
// ---------------------------------------------------------------------------

model Publication {
  id           String      @id @default(cuid())
  type         String // PublicationType: BOOK | COURSE | REPOSITORY | ARTICLE | PODCAST | INTERVIEW | WHITEPAPER
  year         Int
  isbn         String?
  publisher    String?
  // Nur bei type = REPOSITORY (Phase 6.2):
  repoUrl      String?     @db.NVarChar(2048)
  language     String? // Programmiersprache, optional
  coverAssetId String?
  coverAsset   MediaAsset? @relation("PublicationCover", fields: [coverAssetId], references: [id])
  url          String?     @db.NVarChar(2048)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  translations PublicationTranslation[]
  identities   Identity[]               @relation("IdentityPublications")
  sales        PublicationSales[]

  @@index([year])
}

// Verkaufszahlen je Buch, halbjährlich gepflegt (z. B. Periode „2024-H1"). Die
// öffentlichen Summen ergeben sich aus allen Perioden: gedruckt = Σ(printed +
// bundle), PDF = Σ(pdf + bundle). Bundle zählt für beide.
model PublicationSales {
  id            String   @id @default(cuid())
  publicationId String
  period        String // Halbjahr, z. B. „2024-H1"
  printedCount  Int      @default(0)
  pdfCount      Int      @default(0)
  bundleCount   Int      @default(0)
  createdAt     DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, period])
}

model PublicationTranslation {
  id            String  @id @default(cuid())
  publicationId String
  locale        String
  title         String
  role          String? // z. B. „Co-Autorin"
  description   String? @db.NVarChar(Max)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, locale])
}

// ---------------------------------------------------------------------------
// Zertifizierungen / Auszeichnungen
// ---------------------------------------------------------------------------

model Certification {
  id          String      @id @default(cuid())
  name        String
  // Art des Eintrags: CERTIFICATION | MVP | TRAINING (besuchte Schulung/Training)
  // | AWARD (andere Auszeichnung). Steuert die Bereiche im Admin und öffentlich.
  kind        String      @default("CERTIFICATION")
  // Nur für kind=CERTIFICATION relevant: MICROSOFT | METHODICAL — teilt die
  // Zertifizierungen öffentlich in zwei Bereiche.
  family      String      @default("MICROSOFT")
  shortCode   String? // Kürzel, z. B. AI-102
  // Status (Phase 5.3): PLANNED (in Ausbildung) | ACHIEVED | EXPIRED.
  status      String      @default("ACHIEVED")
  plannedFor  String? // optionales Ziel, Datum oder Freitext („Q4 2026")
  acquiredOn  DateTime
  validUntil  DateTime?
  proofUrl    String?     @db.NVarChar(2048)
  series      String? // Reihe für Mehrfachauszeichnungen (z. B. „MVP")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  logoAssetId String?
  logo        MediaAsset? @relation("CertificationLogo", fields: [logoAssetId], references: [id])

  identities Identity[] @relation("IdentityCertifications")

  @@index([series])
}

// ---------------------------------------------------------------------------
// Taxonomie (Kategorien)
// ---------------------------------------------------------------------------

model Taxonomy {
  id        String @id @default(cuid())
  kind      String // TaxonomyKind: DOSSIER | TALK
  nameDe    String
  nameEn    String
  slug      String
  sortOrder Int    @default(0)

  dossiers       Dossier[]  @relation("DossierCategory")
  talks          Talk[]     @relation("TalkCategory")
  // Mehrfachauswahl-Gegenseiten (Join-Tabellen).
  dossierMulti   Dossier[]  @relation("DossierCategories")
  talkMulti      Talk[]     @relation("TalkCategories")
  talkAudiences  Talk[]     @relation("TalkAudiences")
  dispatchTopics Dispatch[] @relation("DispatchTopics")

  @@unique([kind, slug])
  @@index([kind, sortOrder])
}

// ---------------------------------------------------------------------------
// Medien
// ---------------------------------------------------------------------------

model MediaAsset {
  id         String   @id @default(cuid())
  blobPath   String // Original
  width      Int
  height     Int
  mime       String
  altDe      String // Pflicht (SPEC §11)
  altEn      String?
  decorative Boolean  @default(false) // alt="" ausdrücklich (SPEC §11)
  // Herkunft des Bildes: MINE (eigenes), OTHER (von jemand anderem), AI
  // (KI-generiert → Hinweis „KI-generiert" wird überall eingeblendet).
  source     String   @default("MINE")
  credit     String?
  variants   String   @db.NVarChar(Max) // JSON: [{w,format,path}]
  createdAt  DateTime @default(now())

  missionPhotos      MissionPhoto[]
  postHeroes         Post[]          @relation("PostHero")
  publicationCovers  Publication[]   @relation("PublicationCover")
  legendPortraits    LegendContent[] @relation("LegendPortrait")
  certificationLogos Certification[] @relation("CertificationLogo")
  missionBanners     Mission[]       @relation("MissionBanner")
  homeHeroes         HomeContent[]   @relation("HomeHero")
  homeFocusIcons     HomeFocus[]     @relation("HomeFocusIcon")
  // Identitäten (Phase 2)
  identityPortraits  Identity[]      @relation("IdentityPortrait")
  identityEnvelopes  Identity[]      @relation("IdentityEnvelope")
  identityOgs        Identity[]      @relation("IdentityOg")
  toolIcons          Tool[]          @relation("ToolIcon")
  dispatchHeroes     Dispatch[]      @relation("DispatchHero")
}

// ---------------------------------------------------------------------------
// Identitäten (Decknamen) — Phase 2. Nicole tritt je nach Thema unter
// verschiedenen Identitäten auf; diese sind PARALLEL und DAUERHAFT aktiv, nie
// sequenziell. Eine Identität ist ein Objekt mit Inhalt („Umschlag"), kein Tag.
//
// VERBOTEN (CLAUDE_TASKS.md Phase 2.1): activeFrom, activeUntil, archived,
// deprecated, phase, era, isActive. Eine Identität kann unveröffentlicht sein,
// aber niemals „ehemalig". `since` ist als reines Anzeigefeld erlaubt — ohne
// Gegenstück (kein „bis").
// ---------------------------------------------------------------------------

model Identity {
  id   String @id @default(cuid())
  slug String @unique // sprachneutral, URL-fähig

  // — Benennung —
  codenameDe   String  @default("") // Deckname; STOP: von Nicole zu füllen
  codenameEn   String  @default("")
  roleDe       String // nüchterne Rolle (Pflicht, blockierend beim Veröffentlichen)
  roleEn       String  @default("")
  taglineDe    String  @default("")
  taglineEn    String  @default("")
  registryCode String? // z. B. „ID-04". Rein dekorativ, nie als FK oder in URLs
  since        String? // optionales Anzeige-„seit" (KEIN Gegenstück)

  // — Inhalt —
  descriptionDe String @default("") @db.NVarChar(Max) // TipTap JSON
  descriptionEn String @default("") @db.NVarChar(Max)
  shortBioDe    String @default("") @db.NVarChar(Max)
  shortBioEn    String @default("") @db.NVarChar(Max)
  focusDe       String @default("[]") @db.NVarChar(Max) // JSON string[]
  focusEn       String @default("[]") @db.NVarChar(Max)
  languages     String @default("[]") @db.NVarChar(Max) // JSON string[]

  // — Bilder (über die Medienverwaltung) —
  portraitAssetId String?
  portrait        MediaAsset? @relation("IdentityPortrait", fields: [portraitAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  envelopeAssetId String?
  envelope        MediaAsset? @relation("IdentityEnvelope", fields: [envelopeAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ogAssetId       String?
  ogAsset         MediaAsset? @relation("IdentityOg", fields: [ogAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // — Darstellung —
  color     String // Akzentfarbe (Hex), Pflicht, mit Kontrastprüfung
  iconKey   String?
  sortOrder Int     @default(0) // manuelle Reihenfolge, KEINE zeitliche
  isPrimary Boolean @default(false)

  // — SEO —
  metaTitleDe       String?
  metaTitleEn       String?
  metaDescriptionDe String? @db.NVarChar(Max)
  metaDescriptionEn String? @db.NVarChar(Max)

  // — Status —
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools          Tool[]          @relation("IdentityTools")
  missions       Mission[]       @relation("IdentityMissions")
  talks          Talk[]          @relation("IdentityTalks")
  publications   Publication[]   @relation("IdentityPublications")
  certifications Certification[] @relation("IdentityCertifications")
  dispatches     Dispatch[]      @relation("IdentityDispatches")
  focusTopics    FocusTopic[]    @relation("IdentityFocusTopics")

  @@index([published, sortOrder])
}

// Erweiterbarkeit ohne Migration (Phase 2.2): freie Merkmale je Identität.
// Werkzeuge je Identität (Phase 2.3). Die globale Werkzeugliste auf der Legende
// wird aus der Vereinigungsmenge aller Identitäts-Werkzeuge erzeugt.
model Tool {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  iconAssetId String?
  icon        MediaAsset? @relation("ToolIcon", fields: [iconAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  url         String?     @db.NVarChar(2048)
  sortOrder   Int         @default(0)

  identities Identity[] @relation("IdentityTools")
  talks      Talk[]     @relation("TalkTools")
  missions   Mission[]  @relation("MissionTools")

  @@index([sortOrder])
}

// Inhalte der „Legende" (Über-mich-Seite, SPEC §5) — im Admin pflegbar, je
// Sprache eine Zeile. Listen (Säulen, Werkzeuge) als JSON. Porträt verweist auf
// ein hochgeladenes MediaAsset (überlebt Deployments, anders als Dateien im Repo).
model LegendContent {
  locale          String      @id // "de" | "en"
  eyebrow         String
  name            String
  lead            String      @db.NVarChar(Max)
  missionEyebrow  String
  missionText     String      @db.NVarChar(Max)
  pillarsJson     String      @db.NVarChar(Max) // JSON: [{ title, text }]
  toolsJson       String      @db.NVarChar(Max) // JSON: string[]
  contactEyebrow  String
  contactHeading  String
  contactText     String      @db.NVarChar(Max)
  contactButton   String
  contactUrl      String      @db.NVarChar(2048)
  // Aktueller Arbeitgeber (im oberen Legende-Bereich anklickbar dargestellt).
  employerName    String?
  employerUrl     String?     @db.NVarChar(2048)
  portraitAssetId String?
  portrait        MediaAsset? @relation("LegendPortrait", fields: [portraitAssetId], references: [id])
  updatedAt       DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Kanäle / Social Publishing
// ---------------------------------------------------------------------------

model ChannelAccount {
  platform    String    @id // Platform: LINKEDIN | X | INSTAGRAM | FACEBOOK | YOUTUBE
  displayName String
  connected   Boolean   @default(false)
  tokenRef    String? // Key-Vault-Secret-Name, nie das Token selbst
  expiresAt   DateTime?
  lastError   String?   @db.NVarChar(Max)
}

model ChannelTask {
  id          String    @id @default(cuid())
  // Herkunft des Tasks: entweder ein (Alt-)Post oder eine Depesche. `postId`
  // bleibt für Abwärtskompatibilität optional erhalten; neue Tasks tragen
  // `dispatchId` (Phase 3).
  postId      String?
  dispatchId  String?
  platform    String // Platform
  state       String    @default("PENDING") // TaskState
  scheduledAt DateTime
  sentAt      DateTime?
  remoteUrl   String?
  attempts    Int       @default(0)
  lastError   String?   @db.NVarChar(Max)
  payload     String    @db.NVarChar(Max) // vorbereiteter Text + Asset-Referenz

  post     Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  dispatch Dispatch? @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([state, scheduledAt])
  @@index([postId])
  @@index([dispatchId])
}

// ---------------------------------------------------------------------------
// Depeschen (Dispatch) — Phase 3. Führt Signale (Post) und Dossiers zu EINER
// Entität zusammen. Der öffentlich sichtbare Name („Depesche"/„Dispatch") kommt
// aus EINEM i18n-Key (lib/i18n/dictionaries), nicht aus Slugs/Klassen/Feldern —
// ein späterer Namenswechsel erfordert weder Migration noch URL-Änderung.
// Eine Depesche ist an eine Identität gebunden; das Format ist ein Filter.
// ---------------------------------------------------------------------------

model Dispatch {
  id             String      @id @default(cuid())
  format         String      @default("NOTE") // DispatchFormat: NOTE|ANALYSIS|REFERENCE|BACKSTAGE
  status         String      @default("DRAFT") // ContentStatus
  publishAt      DateTime?
  publishedAt    DateTime?
  reviewedAt     DateTime? // sichtbar bei REFERENCE („Wissen mit Haltbarkeit")
  // Zeitpunkt, zu dem die Erinnerungsmail zum nahenden Veröffentlichungsdatum
  // verschickt wurde. Verhindert, dass derselbe Termin mehrfach erinnert wird;
  // wird zurückgesetzt, sobald sich `publishAt` ändert.
  reminderSentAt DateTime?
  sourceUrl      String?     @db.NVarChar(2048)
  sourceTitle    String?
  sourceSite     String?
  sourceImage    String?     @db.NVarChar(2048)
  heroAssetId    String?
  heroAsset      MediaAsset? @relation("DispatchHero", fields: [heroAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  translations DispatchTranslation[]
  identities   Identity[]            @relation("IdentityDispatches")
  topics       Taxonomy[]            @relation("DispatchTopics")
  tasks        ChannelTask[]
  // Radar-Themen (Aufklärung), zu denen diese Depesche gehört. Öffentlich sind
  // die Radar-Punkte anklickbar und filtern die Depeschenliste darauf.
  focusTopics  FocusTopic[]          @relation("DispatchFocusTopics")

  @@index([status, publishAt])
  @@index([format])
}

model DispatchTranslation {
  id         String  @id @default(cuid())
  dispatchId String
  locale     String
  slug       String
  title      String
  summary    String? @db.NVarChar(600)
  bodyJson   String  @db.NVarChar(Max)
  socialText String? @db.NVarChar(2000)
  tocEnabled Boolean @default(false)
  state      String  @default("MISSING")

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@unique([dispatchId, locale])
  @@unique([locale, slug])
}

// ---------------------------------------------------------------------------
// Rechtstexte (SPEC §12). Struktur und Felder werden hier gepflegt; der Inhalt
// wird von Nicole beigestellt bzw. anwaltlich geprüft (keine Rechtstexte im Code).
// ---------------------------------------------------------------------------

model LegalDoc {
  id        String   @id @default(cuid())
  docKey    String // IMPRINT | PRIVACY | ACCESSIBILITY
  locale    String
  title     String
  body      String   @db.NVarChar(Max)
  updatedAt DateTime @updatedAt

  @@unique([docKey, locale])
}

// ---------------------------------------------------------------------------
// Audit-Log
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actor    String
  action   String
  entity   String
  entityId String
  detail   String?  @db.NVarChar(Max)

  @@index([at])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Seiteneinstellungen (Schlüssel/Wert), z. B. Social-Media-Profile im Footer.
// Von Nicole ohne Deployment pflegbar; öffentlich gecacht (Tag "site-settings").
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     String   @db.NVarChar(Max)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Startseiten-Hero (SPEC §5), je Sprache im Admin pflegbar. `headline` und
// `lead` sind Rich-Text-Feldwerte (TipTap-JSON; Akzent-Mark für farbige Wörter),
// `roles` ein JSON-String-Array. Fehlt ein Eintrag, greift der i18n-Standard.
// ---------------------------------------------------------------------------

// Aktuelle Lernthemen / „Womit ich mich gerade beschäftige" (SPEC §5-nah). Muss
// nicht zu einer Zertifizierung führen — dient auch als Vortragsthemen-Ausblick.
model FocusTopic {
  id        String   @id @default(cuid())
  titleDe   String
  titleEn   String?
  note      String?  @db.NVarChar(Max)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Optionale Zuordnung zu Identitäten: „Womit ich mich gerade beschäftige" je
  // Identität. Ohne Zuordnung bleibt ein Thema global (Radar/Ausbildung).
  identities Identity[] @relation("IdentityFocusTopics")
  // Depeschen zu diesem Thema. Erst wenn mindestens eine veröffentlichte
  // Depesche verknüpft ist, wird der Radar-Punkt öffentlich anklickbar.
  dispatches Dispatch[] @relation("DispatchFocusTopics")

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Dokumente (PDF) in der Medienverwaltung — z. B. Vortragsfolien zu einem
// Einsatz. Bewusst getrennt von MediaAsset: Bilder haben Varianten, Alt-Texte
// und Bildherkunft, ein PDF nicht. Der Bezug zum Einsatz läuft weiterhin über
// Mission.slidesFilePath (der Pfad ist der gemeinsame Schlüssel), damit
// bestehende Einsätze unverändert weiterfunktionieren.
// ---------------------------------------------------------------------------
model MediaDocument {
  id        String   @id @default(cuid())
  blobPath  String // Pfad in der Medienablage, wie Mission.slidesFilePath
  fileName  String // Originalname für den Download-Link
  title     String? // optionale Beschreibung („Folien Copilot-Keynote")
  mime      String   @default("application/pdf")
  bytes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Vortragsformate der Akte (Speaker-Kit). Bis hierher entstanden sie aus den
// Dauern der gepflegten Briefings; das blieb richtig, ließ Nicole aber nicht
// sagen, was sie tatsächlich anbietet (etwa einen Workshop, den es als Briefing
// noch nicht gibt). Gepflegte Formate haben Vorrang; ist die Liste leer, greift
// weiterhin die Ableitung aus den Briefing-Dauern (`lib/briefings/formats.ts`).
//
// Dauer als Minutenbereich statt als Text: so wird sie in beiden Sprachen
// richtig formatiert, ohne dass jemand „45 Minuten"/„45 minutes" doppelt pflegt.
// ---------------------------------------------------------------------------
model SpeakerFormat {
  id           String   @id @default(cuid())
  titleDe      String
  titleEn      String?
  noteDe       String?  @db.NVarChar(Max)
  noteEn       String?  @db.NVarChar(Max)
  // Dauer als Zahlenbereich IN DER GEWÄHLTEN EINHEIT: 45 MINUTES, 3 HOURS,
  // 2 DAYS. Ein Workshop dauert Stunden oder Tage; ihn in Minuten zu erfassen
  // und zurückzurechnen wäre eine Rechenaufgabe bei jeder Pflege.
  //
  // Die Spalten heißen in der Datenbank weiterhin `minutesMin`/`minutesMax`
  // (@map): Alle vorhandenen Zeilen stehen in Minuten, und `durationUnit` steht
  // per Vorgabe auf MINUTES — die Werte bleiben also richtig, ohne dass Daten
  // bewegt werden. Ein Spaltenname, den nur noch die Migration kennt, ist der
  // kleinere Preis gegenüber einer Umschichtung im Bestand.
  durationFrom Int?     @map("minutesMin")
  durationTo   Int?     @map("minutesMax")
  // Einheit der beiden Werte: MINUTES | HOURS | DAYS (lib/briefings/speaker-formats.ts).
  durationUnit String   @default("MINUTES")
  // Sprachen, in denen das Format angeboten wird, als Kürzelliste („de,en").
  languages    String   @default("de,en")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// „Woran ich gerade arbeite" auf der Startseite: die Werkzeuge und Themen, mit
// denen Nicole sich aktuell besonders beschäftigt. Je Eintrag ein kleines Logo
// aus der Mediathek und ein Satz. Bewusst getrennt von `Tool` (das ist der
// Stammdatensatz für Filter und Verknüpfungen) und von `FocusTopic` (Radar,
// Ausbildung): hier steht kuratiert, was auf der Startseite erscheint.
//
// Die Höchstzahl steht in `lib/home-focus.ts` und wird beim Speichern geprüft.
// Kein Enddatum, kein Archiv-Flag: ein Eintrag ist aktiv oder er ist weg.
// ---------------------------------------------------------------------------
model HomeFocus {
  id          String      @id @default(cuid())
  titleDe     String
  titleEn     String?
  textDe      String      @db.NVarChar(Max)
  textEn      String?     @db.NVarChar(Max)
  iconAssetId String?
  icon        MediaAsset? @relation("HomeFocusIcon", fields: [iconAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, sortOrder])
}

model HomeContent {
  locale      String      @id
  eyebrow     String?
  headline    String?     @db.NVarChar(Max)
  lead        String?     @db.NVarChar(Max)
  roles       String?     @db.NVarChar(Max)
  heroAssetId String?
  heroAsset   MediaAsset? @relation("HomeHero", fields: [heroAssetId], references: [id])
  updatedAt   DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Reichweite: eigene, datensparsame Zugriffszählung (kein Drittanbieter, keine
// Cookies, keine IP-Speicherung). Je Seitenaufruf eine Zeile mit grobem Land
// und einem tagesbezogenen, nicht umkehrbaren Besucher-Hash (Salt + IP + Tag)
// für eine ungefähre Unique-Zählung. Auswertung im Admin nach Zeitraum und Land.
// ---------------------------------------------------------------------------
model Pageview {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  day         DateTime @db.Date // UTC-Tag, für schnelle Zeitraum-Aggregation
  path        String   @db.NVarChar(512) // Pfad ohne Sprach-Präfix und ohne Query
  locale      String   @db.Char(2)
  section     String   @db.NVarChar(64) // grobe Rubrik (einsaetze, identitaeten, …)
  country     String   @db.Char(2) // ISO-Ländercode oder „XX", wenn unbekannt
  visitorHash String   @db.Char(64) // SHA-256(Salt + IP + Tag), tagesbezogen

  @@index([day])
  @@index([country])
  @@index([section])
  @@index([day, visitorHash])
}

// ---------------------------------------------------------------------------
// Klassischer Lebenslauf (Bewerbungs-CV): Kopf/Zusammenfassung als Singleton,
// die Listen (Werdegang, Ausbildung, Projekte, Fähigkeiten) als Einträge mit
// Rubrik. Im Adminbereich pflegbar, öffentlich als druckbarer CV abrufbar.
// ---------------------------------------------------------------------------
model ResumeProfile {
  id        String   @id @default("default")
  headline  String   @default("") // z. B. „Solution Architect · Microsoft 365 & Azure"
  summary   String   @default("") @db.NVarChar(Max) // Kurzprofil (mehrzeilig)
  location  String   @default("")
  updatedAt DateTime @updatedAt
}

model ResumeEntry {
  id          String   @id @default(cuid())
  section     String // CAREER | EDUCATION | PROJECT | SKILL
  title       String
  subtitle    String? // Arbeitgeber / Institution / Kunde / Skill-Kategorie
  location    String?
  // Zeitraum des Eintrags. Bei PROJECT ist das der EIGENE Einsatz im Projekt;
  // die Laufzeit des Projekts selbst steht in projectFrom/projectTo.
  periodFrom  String? // Freitext, z. B. „03/2018"
  periodTo    String? // Freitext, z. B. „heute"
  description String?  @db.NVarChar(Max) // mehrzeilig; bei SKILL: Liste je Zeile
  tags        String?  @db.NVarChar(Max) // JSON string[] (z. B. Technologien)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  // — nur PROJECT —
  // Laufzeit des Projekts (kann länger sein als der eigene Einsatz darin).
  projectFrom     String?
  projectTo       String?
  // Ungefährer Aufwand des eigenen Einsatzes in Personentagen.
  personDays      Int?
  // Anonymer Kunde: Der Kundenname (subtitle) wird im öffentlichen Lebenslauf
  // und im Export durch eine neutrale Angabe ersetzt, statt ihn zu zeigen.
  clientAnonymous Boolean @default(false)
  // Neutrale Ersatzangabe für anonyme Kunden („Versicherungskonzern").
  clientSector    String?

  // — nur SKILL —
  // Jahre Erfahrung. Sind periodFrom/periodTo als Jahr/Monat lesbar, wird der
  // Wert daraus berechnet; sonst gilt die manuelle Eingabe.
  skillYears Int?
  skillLevel String? // SkillLevel: THEORY | BEGINNER | ADVANCED | EXPERT

  @@index([section, sortOrder])
}

// ---------------------------------------------------------------------------
// Prompt-Werkstatt. Vorlagen für Bild- und Textprompts, die in der Redaktion
// mit den echten Daten eines Einsatzes, Briefings, einer Depesche oder einer
// Identität gefüllt werden. Der Prompt selbst wird nicht gespeichert — er
// entsteht bei jedem Aufruf neu aus Vorlage plus Daten und ist damit immer so
// aktuell wie der Eintrag, auf den er sich bezieht.
//
// Nichts davon ist öffentlich: die Tabellen werden ausschließlich im
// Adminbereich gelesen und geschrieben.
// ---------------------------------------------------------------------------

model PromptTemplate {
  id      String  @id @default(cuid())
  // Stabiler Schlüssel („bild-einsatz"). Über ihn wird der mitgelieferte
  // Standardsatz erkannt und aktualisiert, statt ihn doppelt anzulegen.
  key     String  @unique
  title   String
  kind    String  @default("IMAGE") // PromptKind: IMAGE | TEXT
  subject String  @default("NONE") // PromptSubject: MISSION | TALK | DISPATCH | IDENTITY | NONE
  // Wofür die Vorlage gedacht ist. Steht in der Werkbank als Hilfetext unter
  // dem Namen — damit man beim Auswählen nicht raten muss.
  purpose String? @db.NVarChar(Max)
  body    String  @db.NVarChar(Max) // Vorlagentext mit {{platzhaltern}}

  // Bietet die Werkbank zusätzlich die Identitätsauswahl an? Unabhängig vom
  // Bezug: auch ein Einsatzmotiv wird „unter einer Identität" gebaut.
  withIdentities Boolean @default(false)
  // Seitenverhältnis als Anzeige- und Platzhalterwert („4:5"), rein textlich.
  aspect         String?
  // Beschriftung eines freien Eingabefelds in der Werkbank. Gesetzt heißt: Die
  // Vorlage braucht etwas, das in keinem Datensatz steht — ein Thema, einen
  // Rohentwurf, eine Frage. Der eingegebene Text füllt {{eingabe}}. Leer heißt:
  // kein Feld anbieten.
  inputLabel     String?

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// Wiederverwendbarer Textbaustein, in Vorlagen als {{baustein.<key>}}
// referenziert. Der Stil-Baustein steht damit an EINER Stelle: ändert er sich,
// ändern sich alle Bildprompts mit.
model PromptSnippet {
  id        String   @id @default(cuid())
  key       String   @unique // sprachneutral, klein geschrieben („stil")
  title     String
  body      String   @db.NVarChar(Max)
  note      String?  @db.NVarChar(Max)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
